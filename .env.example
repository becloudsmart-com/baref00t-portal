# ── baref00t platform ────────────────────────────────────────────────────
# from baref00t hosted dashboard
BAREF00T_API_KEY=pk_live_...
# default; override only for staging tests
BAREF00T_API_BASE=https://api.baref00t.io

# ── NextAuth ─────────────────────────────────────────────────────────────
# 32+ random bytes (use `openssl rand -base64 32`)
AUTH_SECRET=
# external URL the portal is reachable at
AUTH_URL=https://portal.partner.com

# ── Partner's own Microsoft Entra app ────────────────────────────────────
# One Entra app reg in your tenant; used for both SSO + Mail.Send.
# your tenant GUID
AZURE_AD_TENANT_ID=
# your app reg GUID
AZURE_AD_CLIENT_ID=
# client secret value
AZURE_AD_CLIENT_SECRET=

# ── Branding (env-driven theme) ──────────────────────────────────────────
BRAND_NAME="Baref00t Partner Portal"
# 6-digit hex; portal nav, buttons, and chrome use this.
BRAND_PRIMARY_COLOR=#00cc66

# Optional — uncomment + set to your CDN URL to show your logo in the nav
# and outbound emails. Leave empty to render no logo (clean text-only look).
# BRAND_LOGO_URL=https://cdn.example.com/logo.svg
# BRAND_FAVICON_URL=https://cdn.example.com/favicon.ico

BRAND_FOOTER_TEXT=
BRAND_CONTACT_EMAIL=
# dark | light
BRAND_THEME=dark

# ── Outbound mail (Microsoft Graph SendMail) ─────────────────────────────
# Optional. If MAIL_FROM_ADDRESS is unset, all outbound mail is a no-op.
# The app reg above must have Mail.Send (Application) permission and
# admin consent in your tenant. See docs/MAIL-SETUP.md.
MAIL_FROM_ADDRESS=security-no-reply@acme.com
MAIL_FROM_DISPLAY_NAME=Acme Security Reports

# ── Optional ─────────────────────────────────────────────────────────────
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
PORT=3000
NODE_ENV=production
# OTEL_EXPORTER_OTLP_ENDPOINT=https://your-otlp.example.com
